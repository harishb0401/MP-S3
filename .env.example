# ==============================================================================
# MySQL Database Configuration Example (.env)
# Copy this file to .env and configure with your local or production database credentials.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=makkal_nagar_grievance
DB_USERNAME=makkal_app
DB_PASSWORD=your_secure_password_here

# Optional: Full JDBC URL Override (if specified, overrides individual host/port/name settings)
# DB_URL=jdbc:mysql://localhost:3306/makkal_nagar_grievance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Server Port (default 8080)
PORT=8080
